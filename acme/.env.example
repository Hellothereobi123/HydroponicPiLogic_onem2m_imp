# Copy to acme/.env (gitignored) and set a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Bearer tokens are hashed with this secret, so changing it invalidates every token in
# certs/http_token_auth.txt (regenerate them with: cd pi && python3 -m onem2m.make_token).
ACME_SECURITY_SECRET=change-me
